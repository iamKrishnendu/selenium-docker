pipeline {
    agent any
    stages {
        stage("checkout"){
            steps{
                checkout scm
            }
        }
        stage('Install maven container') {
            steps {
                      sh '''
                        docker run --rm \
                          --network container:jenkins \
                          -v "$PWD:/workspace" \
                          -v "$HOME/.m2:/root/.m2" \
                          -w /workspace \
                          maven:3.9.6-eclipse-temurin-17 \
                          mvn --version
                        '''
               }
        }
        stage('build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('test') {
             steps {
               sh 'mvn test -Dbrowser=chrome -DisRemote=yes'
            }
        }
    }

post{
     always{
        echo "Build ${currentBuild.fullDisplayName} has ${currentBuild.currentResult}."
        cleanWs()
        }
    }
}
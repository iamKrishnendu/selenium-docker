pipeline {
    agent any

    tools {
            maven 'maven-3.9.12'
            jdk 'jdk17'
    }

    stages {
        stage("checkout"){
            steps{
                checkout scm
            }
        }

        stage('build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('test') {
             steps {
               sh '''
               mvn test \
               -Dbrowser=chrome \
               -DisRemote=true \
               -Dselenium.url=http://selenium:4444/wd/hub
               '''
            }
        }
    }

post{
     always{
        echo "Build ${currentBuild.fullDisplayName} has ${currentBuild.currentResult}."
        cleanWs()
        }
    }
}
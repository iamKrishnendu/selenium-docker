pipeline {
    agent any

    parameters{
        string(
            name: 'BROWSER',
            defaultValue: 'chrome',
            description: 'Browser to run tests'
        )
        string(
                    name: 'IS_REMOTE',
                    defaultValue: 'true',
                    description: 'Run tests on Selenium Grid'
                )
    }

    tools {
            maven 'maven-3.9.12'
            jdk 'jdk17'
    }

    stages {
        stage("checkout"){
            steps{
                checkout scm
            }
        }

        stage('build') {
            steps {
                sh 'mvn clean compile'
            }
        }
        stage('test') {
             steps {
               sh """
                   mvn test \
                   -Dbrowser=${params.BROWSER} \
                   -DisRemote=${params.IS_REMOTE} \
                   -Dselenium.url=http://selenium:4444/wd/hub
                  """
            }
        }
    }

post{
     always{
        echo "Build ${currentBuild.fullDisplayName} has ${currentBuild.currentResult}."
        junit '**/target/surefire-reports/junitreports/TEST-*.xml'
        publishHTML(target: [
                    reportName: 'TestNG HTML Report',
                    reportDir: 'target/surefire-reports/junitreports',
                    reportFiles: 'index.html',
                    keepAll: true,
                    alwaysLinkToLastBuild: true
                ])

        cleanWs()
        }
    }
}